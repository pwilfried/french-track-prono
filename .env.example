# Copier ce fichier en .env.local puis remplir avec les valeurs affichées par `supabase start`

# Adresse de l'API Supabase locale
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé publique (anon) : peut aller dans le navigateur
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role : SERVEUR UNIQUEMENT, ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Adresse du site en local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra hostnames allowed to load the dev server (comma separated), e.g. a tunnel. Optional.
DEV_ALLOWED_ORIGINS=
