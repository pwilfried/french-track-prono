# Copier ce fichier en .env.local puis remplir avec les valeurs affichées par `supabase start`

# Adresse de l'API Supabase locale
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé publique (anon) : peut aller dans le navigateur
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role : SERVEUR UNIQUEMENT, ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Préproduction seulement (#637) : 1 active « Se connecter en tant que » un joueur démo dans le
# back-office. Jamais en prod. Serveur uniquement.
PREPROD_DEMO_LOGIN=

# Adresse du site en local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra hostnames allowed to load the dev server (comma separated), e.g. a tunnel. Optional.
DEV_ALLOWED_ORIGINS=

# Competition shown by the app (default: ultimate-championship-2026). Server only.
COMPETITION_SLUG=

# Captcha of the sign-in page (Cloudflare Turnstile, #331): the public site key. Empty: no captcha
# (local, CI). The secret key goes in Supabase (Authentication → Attack Protection), never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
